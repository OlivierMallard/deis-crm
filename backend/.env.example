# Identifiants fictifs de developpement local, aucun secret de production.
# Correspond au service PostgreSQL dans docker-compose.yml.
DATABASE_URL="postgresql://crm_user:crm_dev_password@localhost:5432/crm_deis?schema=public"
# Origine publique exacte du frontend (aucun slash final).
APP_ORIGIN="http://localhost:5173"
# En production : NODE_ENV=production, HTTPS obligatoire (cookie Secure).
NODE_ENV="development"
# Purge fictive désactivée par défaut ; jamais autorisée en production.
ALLOW_DEV_PURGE="false"
