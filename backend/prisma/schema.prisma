generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Prospect {
  actions   Action[]
  id        Int            @id @default(autoincrement())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  status    ProspectStatus @default(NEW)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}


enum ActionType {
  CALL
  EMAIL
  MEETING
  TASK
  OTHER
}

model Action {
  id          Int        @id @default(autoincrement())
  prospectId  Int
  prospect    Prospect   @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  type        ActionType
  title       String
  description String?
  dueAt       DateTime   @db.Timestamptz(3)
  completedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([prospectId])
  @@index([dueAt])
}
