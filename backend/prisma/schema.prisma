generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Prospect {
  convertedClient Client?
  actions   Action[]
  id        Int            @id @default(autoincrement())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  status    ProspectStatus @default(NEW)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}


enum ActionType {
  CALL
  EMAIL
  MEETING
  TASK
  OTHER
}

model Action {
  id          Int        @id @default(autoincrement())
  prospectId  Int
  prospect    Prospect   @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  type        ActionType
  title       String
  description String?
  dueAt       DateTime   @db.Timestamptz(3)
  completedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([prospectId])
  @@index([dueAt])
}


enum ContractStatus {
  DRAFT
  PROPOSED
  SIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Client {
  quotes Quote[]
  invoices Invoice[]
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  company String?
  email String?
  phone String?
  notes String?
  sourceProspectId Int? @unique
  sourceProspect Prospect? @relation(fields: [sourceProspectId], references: [id], onDelete: Restrict)
  contracts Contract[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  quotes Quote[]
  invoices Invoice[]
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reference String @unique
  title String
  description String?
  amountCents Int
  currency String @default("EUR")
  status ContractStatus @default(DRAFT)
  startDate DateTime?
  endDate DateTime?
  signedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
  @@index([status])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}
enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHECK
  OTHER
}
model Quote {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId Int?
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reference String @unique
  title String
  description String?
  status QuoteStatus @default(DRAFT)
  issueDate DateTime @db.Date
  validUntil DateTime? @db.Date
  vatExemptionMention String?
  totalExclTaxCents Int
  vatCents Int
  totalInclTaxCents Int
  lines QuoteLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
  @@index([contractId])
  @@index([status])
}
model QuoteLine {
  id Int @id @default(autoincrement())
  quoteId Int
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity Decimal @db.Decimal(12, 4)
  unitPriceCents Int
  vatRateBasisPoints Int @default(0)
  position Int
  totalExclTaxCents Int
  vatCents Int
  totalInclTaxCents Int
  @@unique([quoteId, position])
}
model Invoice {
  id Int @id @default(autoincrement())
  clientId Int
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId Int?
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reference String @unique
  title String
  issueDate DateTime @db.Date
  dueDate DateTime @db.Date
  totalExclTaxCents Int
  vatRateBasisPoints Int @default(0)
  vatCents Int
  totalInclTaxCents Int
  vatExemptionMention String?
  status InvoiceStatus @default(DRAFT)
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId])
  @@index([contractId])
  @@index([status, dueDate])
}
model Payment {
  id Int @id @default(autoincrement())
  invoiceId Int
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents Int
  paidAt DateTime @db.Date
  method PaymentMethod
  reference String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([invoiceId])
  @@index([paidAt])
}
